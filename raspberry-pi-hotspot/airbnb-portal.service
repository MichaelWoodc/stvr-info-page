[Unit]
Description=Local captive portal visitor counter and guestbook
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/airbnb-portal/portal-server.py
WorkingDirectory=/usr/local/lib/airbnb-portal
StateDirectory=airbnb-portal
StateDirectoryMode=0700
DynamicUser=yes
SupplementaryGroups=audio
Environment=PORTAL_AUDIO_DEVICE=plughw:CARD=Headphones,DEV=0
Environment=PORTAL_BELL_ENABLED=1
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
